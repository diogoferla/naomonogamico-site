---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContributeBand from '../components/ContributeBand.astro';
import { SITE } from '../config/site';
import { getPage, emphasize } from '../lib/content';
import { render } from 'astro:content';
const entry = await getPage('sobre');
const page = entry.data;
const { Content } = await render(entry);
const crumbs = [{ name: 'Sobre', href: '/sobre' }];
---
<BaseLayout
  title={page.seo_title}
  description={page.seo_description}
  breadcrumbs={crumbs}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Sobre o Não Monogâmico', url: new URL('/sobre', SITE.url).toString() }]}
>
  <PageHeader
    eyebrow={page.eyebrow}
    title={emphasize(page.title)}
    lede={page.lede}
    breadcrumbs={crumbs}
    tone="coral"
  />

  <section class="section">
    <div class="wrap about-grid">
      <div class="prose">
        <Content />
      </div>

      {page.facts.length > 0 && (
        <aside class="facts" aria-label="Resumo">
          <dl>
            {page.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>
        </aside>
      )}
    </div>
  </section>

  <ContributeBand title="Quer ajudar o projeto a crescer?" label="Ver formas de contribuir" />
</BaseLayout>

<style>
  .about-grid { display: grid; gap: var(--s-7); align-items: start; }
  .prose { max-width: var(--wrap-text); }
  .facts { background: linear-gradient(var(--card), var(--card)) padding-box, var(--grad) border-box; border: 1.5px solid transparent; border-radius: var(--radius-l); padding: var(--s-6); }
  .facts dl { display: flex; flex-direction: column; gap: var(--s-5); }
  .facts dt { font-size: var(--step--1); letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal-ink); font-weight: 700; }
  .facts dd { margin: var(--s-1) 0 0; font-family: var(--font-display); font-size: var(--step-1); line-height: 1.3; }
  @media (min-width: 1000px) {
    .about-grid { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--s-8); }
    .facts { position: sticky; top: 6rem; }
  }
</style>
