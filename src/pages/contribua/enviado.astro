---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Indicação recebida" description="Sua indicação foi recebida." noindex>
  <section class="section">
    <div class="wrap-text stack" style="--stack: var(--s-5)">
      <p class="eyebrow">Contribua</p>
      <h1>Recebemos sua <em>indicação</em>.</h1>
      <p class="lede">Obrigado por ajudar o projeto a crescer. Tudo é revisado antes de ser publicado.</p>
      <div class="flow-row">
        <a class="btn" href="/contribua">Fazer outra indicação</a>
        <a class="btn btn-ghost" href="/">Voltar ao início</a>
      </div>
    </div>
  </section>
</BaseLayout>
