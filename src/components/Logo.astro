---
/**
 * Assinatura horizontal: símbolo da logo (três figuras entrelaçadas) + nome.
 * A logo completa (selo circular) fica em /public/brand/logo-badge.(webp|png).
 */
import { SITE } from '../config/site';
interface Props { size?: 'sm' | 'md' | 'lg'; showName?: boolean }
const { size = 'md', showName = true } = Astro.props;
---
<span class:list={['logo', `logo-${size}`]}>
  <img class="mark" src="/brand/symbol.png" width="262" height="147" alt="" decoding="async" />
  {showName && <span class="word">{SITE.name}</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6em; color: var(--ink); }
  .mark { width: auto; height: 1.9em; flex: none; }
  .word {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .logo-sm { font-size: 0.85rem; }
  .logo-md { font-size: 0.95rem; }
  .logo-lg { font-size: 1.25rem; }
  @media (max-width: 380px) { .logo-md { font-size: 0.82rem; } }
</style>
