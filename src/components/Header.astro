---
import Logo from './Logo.astro';
import { NAV } from '../config/site';
import { cleanPath } from '../lib/content';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Não Monogâmico — página inicial">
      <Logo size="md" />
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul role="list">
        {NAV.filter((i) => !i.highlight).map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a href="/eventos" class="btn btn-sm events-cta" aria-current={isActive('/eventos') ? 'page' : undefined}>
        <span class="pulse" aria-hidden="true"></span> Eventos
      </a>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
      <span class="sr-only" data-menu-label>Abrir menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-menu>
    <nav aria-label="Principal (celular)" class="wrap">
      <ul role="list">
        {NAV.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={{ hl: item.highlight }}>
              {item.label}{item.highlight && <span class="tag tone-coral">agenda</span>}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-foot">
        <a href="/faq">Perguntas frequentes</a>
        <a href="/contribua">Indique algo</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .site-header.scrolled { border-bottom-color: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); min-height: 72px; }
  .brand { text-decoration: none; display: inline-flex; padding-block: var(--s-2); }

  .nav-desktop { display: none; align-items: center; gap: var(--s-5); }
  .nav-desktop ul { display: flex; gap: var(--s-1); }
  .nav-desktop ul a {
    display: inline-block; padding: 0.5em 0.75em; border-radius: 999px;
    text-decoration: none; font-weight: 500; font-size: 0.97rem; color: var(--ink-2);
    transition: background-color 0.15s, color 0.15s;
  }
  .nav-desktop ul a:hover { background: var(--paper-2); color: var(--ink); }
  .nav-desktop ul a[aria-current='page'] { color: var(--ink); background: var(--paper-2); font-weight: 600; }
  .events-cta { gap: 0.6em; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--sun); box-shadow: 0 0 0 0 rgba(242, 179, 61, 0.6); }
  @media (prefers-reduced-motion: no-preference) {
    .pulse { animation: pulse 2.4s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(242,179,61,.55);} 70% { box-shadow: 0 0 0 8px rgba(242,179,61,0);} 100% { box-shadow: 0 0 0 0 rgba(242,179,61,0);} }
  }

  .menu-btn {
    width: 48px; height: 48px; border-radius: 50%;
    border: 1.5px solid var(--ink); background: transparent;
    display: grid; place-items: center;
  }
  .burger { display: grid; gap: 6px; width: 18px; }
  .burger span { height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.25s var(--ease); }
  [aria-expanded='true'] .burger span:first-child { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .burger span:last-child { transform: translateY(-4px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: 72px 0 0 0; background: var(--paper);
    overflow-y: auto; padding-block: var(--s-5) var(--s-7);
    border-top: 1px solid var(--line-soft);
  }
  .mobile-menu ul { display: flex; flex-direction: column; }
  .mobile-menu li { border-bottom: 1px solid var(--line-soft); }
  .mobile-menu li a {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.7em 0; text-decoration: none;
    font-family: var(--font-display); font-weight: 600; font-size: var(--step-2); line-height: 1.1;
  }
  .mobile-menu li a[aria-current='page'] { color: var(--coral-ink); }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) li { animation: rise 0.4s var(--ease) both; animation-delay: calc(var(--i) * 35ms); }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  }
  .mobile-foot { display: flex; gap: var(--s-5); margin-top: var(--s-6); color: var(--ink-2); }

  @media (min-width: 1040px) {
    .nav-desktop { display: flex; }
    .menu-btn, .mobile-menu { display: none !important; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  const setOpen = (open: boolean) => {
    if (!btn || !menu || !label) return;
    btn.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    label.textContent = open ? 'Fechar menu' : 'Abrir menu';
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
  });
  window.matchMedia('(min-width: 1040px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
